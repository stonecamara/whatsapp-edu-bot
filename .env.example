AI_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_HTTP_CLIENT=sdk
GROQ_CHAT_MODEL=groq/compound-mini
GROQ_VISION_MODEL=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_HTTP_CLIENT=sdk

# Runtime
BOT_NAME=ScholarAI
MAX_HISTORY_MESSAGES=12
MAX_CHAT_TOKENS=700
MAX_PDF_TOKENS=900
RATE_LIMIT_RETRIES=3
AUTH_DIR=auth
TMP_DIR=tmp
MEDIA_DOWNLOAD_TIMEOUT_MS=12000
MEDIA_DOWNLOAD_RETRIES=2
VOICE_REPLY_TO_INCOMING=false
VOICE_MAX_TTS_CHARS=160
TTS_TIMEOUT_MS=8000
